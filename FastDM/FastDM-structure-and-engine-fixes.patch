-        static string Fmt(double b)
-        {
-            string[] u =
-            {
-                "B",
-                "KB",
-                "MB",
-                "GB",
-                "TB"
-            };
-
-            int i = 0;
-
-            while (b >= 1024 &&
-                   i < u.Length - 1)
-            {
-                b /= 1024;
-                i++;
-            }
-
-            return (
-                i == 0
-                    ? b.ToString("0")
-                    : b.ToString("0.##"))
-                   + " " +
-                   u[i];
-        }
-
-        static string Eta(DownloadItem it)
-        {
-            if (it.State != DlState.Downloading ||
-                it.Speed < 1 ||
-                it.TotalBytes <= 0)
-                return "";
-
-            var t = TimeSpan.FromSeconds(
-                (it.TotalBytes - it.Downloaded) /
-                it.Speed);
-
-            if (t.TotalHours >= 1)
-                return (int)t.TotalHours +
-                       "h " +
-                       t.Minutes +
-                       "m";
-
-            if (t.TotalMinutes >= 1)
-                return t.Minutes +
-                       "m " +
-                       t.Seconds +
-                       "s";
-
-            return t.Seconds + "s";
-        }
