+                    return;
+                }
+            }
+
+            using var pf =
+                new MediaPickerForm(
+                    opts,
+                    saveFolder);
+
+            Theme.Apply(pf);
+
+            if (pf.ShowDialog(this) !=
+                DialogResult.OK)
+                return;
+
+            string folder = pf.SaveFolder;
+
+            var spec = pf.Spec;
+            if (spec == null) return;
+            string ext =
+                spec.AudioOnly
+                    ? ".m4a"
+                    : ".mp4";
