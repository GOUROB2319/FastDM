-                File.Exists(it.SavePath)
-                    ? it.SavePath
-                    : File.Exists(it.TempPath)
-                        ? it.TempPath
-                        : null;
-
-            if (target != null)
-            {
-                Process.Start(
-                    "explorer.exe",
-                    "/select,\"" + target + "\"");
