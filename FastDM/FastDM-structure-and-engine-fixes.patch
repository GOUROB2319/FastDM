+using System.Net;
+using System.Net.Http;
+using System.Net.Http.Headers;
+using System.IO.Pipes;
+using System.Text;
+using System.Text.Json;
+using System.Text.Json.Serialization;
+using System.Threading;
+using System.Threading.Tasks;
+using System.Windows.Forms;
+using Microsoft.Win32;
+
+namespace FastDM
+{
+    // MainForm part: download list rows, colors, history.
+    public partial class MainForm
+    {
+        static Color RowColor(DownloadItem it) =>
+            it.DeletedAt.HasValue ? Gray : StateColor(it.State);
+
+        static Color StateColor(DlState s)
+        {
+            switch (s)
+            {
+                case DlState.Downloading:
+                    return Theme.P.Accent;
+
+                case DlState.Completed:
+                    return Green;
+
+                case DlState.Paused:
+                    return Orange;
+
+                case DlState.Error:
+                    return Red;
+
+                default:
+                    return Gray;
+            }
+        }
+
+        // ---------- লিস্ট ----------
+        static bool Match(
+            int f,
+            DownloadItem i)
+        {
+            switch (f)
+            {
+                case 1:
+                    return i.State == DlState.Downloading;
+
+                case 2:
+                    return i.State == DlState.Queued ||
+                           i.State == DlState.Paused;
+
+                case 3:
+                    return i.State == DlState.Completed;
+
+                case 4:
+                    return i.State == DlState.Error;
+
+                default:
+                    return true;
+            }
+        }
+
+        IEnumerable<DownloadItem> VisibleItems() =>
+            filter == DeletedFilter
+                ? deleted.OrderByDescending(i => i.DeletedAt ?? i.Added)
+                : items.Where(i => Match(filter, i)).OrderByDescending(i => i.Added);
+
+        // Keeps a copy of a download that is leaving the list, with the time and the reason.
+        void RecordDeleted(DownloadItem it, string reason)
+        {
+            var rec = new DownloadItem
+            {
+                Url = it.Url,
+                FileName = it.FileName,
+                Folder = it.Folder,
+                Referer = it.Referer,
+                UserAgent = it.UserAgent,
+                ContentType = it.ContentType,
+                TotalBytes = it.TotalBytes,
+                SupportsRange = it.SupportsRange,
+                Stream = it.Stream,
+                YtDlp = it.YtDlp,
+                Added = it.Added,
+                State = it.State == DlState.Downloading ? DlState.Paused : it.State,
+                Error = it.Error,
+                DeletedAt = DateTime.Now,
+                DeletedReason = reason
+            };
+
+            rec.Downloaded = it.Downloaded;
+
+            deleted.Insert(0, rec);
+
+            while (deleted.Count > MaxDeletedHistory)
+                deleted.RemoveAt(deleted.Count - 1);
+        }
+
+        // "Download again" in the Deleted list: a fresh download from the same link, folder and options.
+        void DownloadAgain()
+        {
+            var sel = Sel().Where(i => i.DeletedAt.HasValue && !string.IsNullOrEmpty(i.Url)).ToList();
+
+            if (sel.Count == 0)
+                return;
+
+            if (MessageBox.Show(
+                    this,
+                    "Download " + sel.Count + " item(s) again?",
+                    "Deleted",
+                    MessageBoxButtons.OKCancel,
+                    MessageBoxIcon.Question) != DialogResult.OK)
+                return;
+
+            foreach (var d in sel)
+            {
+                var it = new DownloadItem
+                {
+                    Url = d.Url,
+                    Folder = d.Folder,
+                    FileName = d.FileName,
+                    Referer = d.Referer,
+                    UserAgent = d.UserAgent,
+                    ContentType = d.ContentType,
+                    TotalBytes = d.TotalBytes,
+                    SupportsRange = d.SupportsRange,
+                    Stream = d.Stream,
+                    YtDlp = d.YtDlp,
+                    NeedsProbe = DownloadEngine.IsHttp(d.Url) && d.TotalBytes <= 0,
+                    State = DlState.Queued
+                };
+
+                deleted.Remove(d);
+                items.Add(it);
+                selectNewId = it.Id;
+            }
+
+            MarkChanged();
+            SaveState();
+
+            lblActive.Text = sel.Count + " download(s) added again.";
+        }
+
+        void RemoveFromHistory(List<DownloadItem> sel)
+        {
+            if (MessageBox.Show(
+                    this,
+                    "Remove " + sel.Count + (sel.Count == 1 ? " entry" : " entries") +
+                    " from the Deleted list?\n\nFiles on your disk are not touched.",
+                    "Deleted",
+                    MessageBoxButtons.OKCancel,
+                    MessageBoxIcon.Question) != DialogResult.OK)
+                return;
+
+            foreach (var d in sel)
+                deleted.Remove(d);
+
+            MarkChanged();
+            SaveState();
+        }
+
+        void ClearHistory()
+        {
+            if (deleted.Count == 0)
+                return;
+
+            if (MessageBox.Show(
+                    this,
+                    "Clear the whole Deleted list (" + deleted.Count + " entries)?\n\nFiles on your disk are not touched.",
+                    "Deleted",
+                    MessageBoxButtons.OKCancel,
+                    MessageBoxIcon.Question) != DialogResult.OK)
+                return;
+
+            deleted.Clear();
+
+            MarkChanged();
+            SaveState();
+        }
+
+        void RebuildList()
+        {
+            var selected =
+                lv.SelectedItems
+                  .Cast<ListViewItem>()
+                  .Select(l => l.Tag)
+                  .OfType<DownloadItem>()
+                  .Select(it => it.Id)
+                  .ToHashSet();
+
+            lv.BeginUpdate();
+
+            if (lv.Columns.Count > 6)
+                lv.Columns[6].Text = filter == DeletedFilter ? "Deleted" : "Added";
+
+            lv.Items.Clear();
+
+            foreach (var it in VisibleItems())
+            {
+                var lvi =
+                    new ListViewItem(
+                        new[]
+                        {
+                            "",
+                            "",
+                            "",
+                            "",
+                            "",
+                            "",
+                            ""
+                        })
+                    {
+                        Tag = it
+                    };
+
+                lv.Items.Add(lvi);
+
+                FillRow(lvi, it);
+
+                if (selected.Contains(it.Id))
+                    lvi.Selected = true;
+            }
+
+            lv.EndUpdate();
+
+            if (selectNewId != null)
+            {
+                string id = selectNewId;
+                selectNewId = null;
+
+                var target =
+                    lv.Items
+                      .Cast<ListViewItem>()
+                      .FirstOrDefault(l => l.Tag is DownloadItem d && d.Id == id);
+
+                if (target != null)
+                {
+                    foreach (ListViewItem l in lv.SelectedItems.Cast<ListViewItem>().ToList())
+                        l.Selected = false;
+
+                    target.Selected = true;
+                    target.Focused = true;
+                    target.EnsureVisible();
+                }
+            }
+
+            UpdateSideCounts();
+            sidebar.Invalidate();
+        }
+
+        static void SetIf(
+            ListViewItem l,
+            int idx,
+            string text)
+        {
+            if (l.SubItems[idx].Text != text)
+                l.SubItems[idx].Text = text;
+        }
+
+        static void FillDeletedRow(
+            ListViewItem l,
+            DownloadItem it)
+        {
+            SetIf(l, 0, it.FileName ?? "");
+
+            SetIf(
+                l,
+                1,
+                it.TotalBytes > 0
+                    ? Fmt(it.TotalBytes)
+                    : it.Downloaded > 0
+                        ? Fmt(it.Downloaded)
+                        : "\u2014");
+
+            SetIf(l, 2, it.Percent.ToString("0.0") + "%");
+            SetIf(l, 3, it.DeletedReason ?? "Deleted");
+            SetIf(l, 4, "");
+            SetIf(l, 5, "");
+            SetIf(l, 6, (it.DeletedAt ?? it.Added).ToString("dd MMM HH:mm"));
+
+            l.ToolTipText = it.Url;
+        }
+
+        void FillRow(
+            ListViewItem l,
+            DownloadItem it)
+        {
+            if (it.DeletedAt.HasValue)
+            {
+                FillDeletedRow(l, it);
+                return;
+            }
+
+            SetIf(
+                l,
+                0,
+                it.FileName);
+
+            SetIf(
+                l,
+                1,
+                it.TotalBytes > 0
+                    ? (
+                        it.Stream != null &&
+                        it.State != DlState.Completed
+                            ? "~"
+                            : "") +
+                      Fmt(it.TotalBytes)
+                    : "—");
+
+            SetIf(
+                l,
+                2,
+                it.Percent.ToString("0.0") + "%");
+
+            SetIf(
+                l,
+                3,
+                it.State == DlState.Downloading &&
+                !string.IsNullOrEmpty(it.StatusNote)
+                    ? it.StatusNote
+                    : it.State == DlState.Queued &&
+                      scheduleBlocked &&
+                      !it.IgnoreSchedule
+                        ? "Scheduled"
+                        : it.State == DlState.Paused &&
+                          it.PausedBySchedule
+                            ? "Paused (schedule)"
+                            : StateText(it.State));
+
+            SetIf(
+                l,
+                4,
+                it.State == DlState.Downloading
+                    ? Fmt(it.Speed) + "/s"
+                    : "");
+
+            SetIf(
+                l,
+                5,
+                Eta(it));
+
+            SetIf(
+                l,
+                6,
+                it.Added.ToString("dd MMM HH:mm"));
+
+            l.ToolTipText =
+                it.State == DlState.Error
+                    ? it.Error
+                    : it.Url;
+        }
+
+        static string StateText(DlState s) =>
+            s == DlState.Completed
+                ? "Complete"
+                : s.ToString();
+
+        static string Fmt(double b)
+        {
+            string[] u =
+            {
+                "B",
+                "KB",
+                "MB",
+                "GB",
+                "TB"
+            };
+
+            int i = 0;
+
+            while (b >= 1024 &&
+                   i < u.Length - 1)
+            {
+                b /= 1024;
+                i++;
+            }
+
+            return (
+                i == 0
+                    ? b.ToString("0")
+                    : b.ToString("0.##"))
+                   + " " +
+                   u[i];
+        }
+
+        static string Eta(DownloadItem it)
+        {
+            if (it.State != DlState.Downloading ||
+                it.Speed < 1 ||
+                it.TotalBytes <= 0)
+                return "";
+
+            var t = TimeSpan.FromSeconds(
+                (it.TotalBytes - it.Downloaded) /
+                it.Speed);
+
+            if (t.TotalHours >= 1)
+                return (int)t.TotalHours +
+                       "h " +
+                       t.Minutes +
+                       "m";
+
+            if (t.TotalMinutes >= 1)
+                return t.Minutes +
+                       "m " +
+                       t.Seconds +
+                       "s";
+
+            return t.Seconds + "s";
+        }
+
+        void SelectAllRows()
+        {
+            lv.BeginUpdate();
+
+            try
+            {
+                foreach (ListViewItem l in lv.Items)
+                    l.Selected = true;
+            }
+            finally
+            {
+                lv.EndUpdate();
+            }
+        }
+
+        List<DownloadItem> Sel() =>
+            lv.SelectedItems
+              .Cast<ListViewItem>()
+              .Select(l => l.Tag)
+              .OfType<DownloadItem>()
+              .ToList();
+
+        void MarkChanged()
+        {
+            dirty = true;
+        }
+    }
+}
diff --git a/FastDM/UI/MainForm.Settings.cs b/FastDM/UI/MainForm.Settings.cs
new file mode 100644
index 0000000..4945c49
--- /dev/null
+++ b/FastDM/UI/MainForm.Settings.cs
@@ -0,0 +1,511 @@
+using System;
+using System.Collections.Generic;
+using System.Diagnostics;
+using System.Drawing;
+using System.Drawing.Drawing2D;
+using System.IO;
+using System.Linq;
+using System.Net;
+using System.Net.Http;
+using System.Net.Http.Headers;
+using System.IO.Pipes;
+using System.Text;
+using System.Text.Json;
+using System.Text.Json.Serialization;
+using System.Threading;
+using System.Threading.Tasks;
+using System.Windows.Forms;
+using Microsoft.Win32;
+
+namespace FastDM
+{
+    // MainForm part: schedule, preferences, traffic mode and theme.
+    public partial class MainForm
+    {
+        // ---------- শিডিউলার / "সব শেষ হলে" / ডিটেইলস ----------
+        void ShowSchedule()
+        {
+            using var f =
+                new ScheduleForm(settings);
+
+            Theme.Apply(f);
+            f.ShowDialog(this);
+
+            SaveState();
+
+            lastAllowed = null;
+            MarkChanged();
+        }
+
+        void StartNowSelected()
+        {
+            if (filter == DeletedFilter)
+                return;
+
+            foreach (var it in Sel())
+            {
+                if (it.State ==
+                        DlState.Paused ||
+                    it.State ==
+                        DlState.Error ||
+                    it.State ==
+                        DlState.Queued)
+                {
+                    it.IgnoreSchedule = true;
+                    it.PausedBySchedule = false;
+                    it.State = DlState.Queued;
+                    it.Error = null;
+                }
+            }
+
+            MarkChanged();
+        }
+
+        void ToggleDetails()
+        {
+            settings.ShowDetails =
+                !settings.ShowDetails;
+
+            details.Visible =
+                settings.ShowDetails;
+
+            details.SetItem(
+                Sel().FirstOrDefault());
+
+            SaveState();
+        }
+
+        void BuildDoneMenu()
+        {
+            bool icons =
+                Icons.Available;
+
+            doneMenu =
+                new ToolStripDropDownButton(
+                    icons
+                        ? "When done"
+                        : "⏻  When done")
+                {
+                    DisplayStyle = icons
+                        ? ToolStripItemDisplayStyle.ImageAndText
+                        : ToolStripItemDisplayStyle.Text,
+
+                    TextImageRelation =
+                        TextImageRelation.ImageBeforeText,
+
+                    Padding =
+                        new Padding(4),
+
+                    Tag = new IconTag
+                    {
+                        Glyph = "\uE7E8",
+                        Accent = false
+                    }
+                };
+
+            foreach (var a in new[]
+                     {
+                         PostAction.None,
+                         PostAction.Shutdown,
+                         PostAction.Sleep,
+                         PostAction.Hibernate
+                     })
+            {
+                var act = a;
+
+                string label =
+                    act == PostAction.None
+                        ? "Do nothing"
+                        : act == PostAction.Shutdown
+                            ? "Shut down the computer"
+                            : act == PostAction.Sleep
+                                ? "Sleep"
+                                : "Hibernate";
+
+                var mi =
+                    new ToolStripMenuItem(label)
+                    {
+                        Tag = act
+                    };
+
+                mi.Click += (s, e) =>
+                {
+                    afterAll = act;
+                };
+
+                doneMenu.DropDownItems.Add(mi);
+            }
+
+            doneMenu.DropDownOpening += (s, e) =>
+            {
+                foreach (var mi in doneMenu.DropDownItems
+                    .OfType<ToolStripMenuItem>())
+                {
+                    if (mi.Tag is PostAction pa)
+                        mi.Checked =
+                            pa == afterAll;
+                }
+            };
+        }
+
+        void RunAfterAllAction()
+        {
+            var act = afterAll;
+
+            if (act ==
+                PostAction.None)
+                return;
+
+            afterAll =
+                PostAction.None;
+
+            SaveState();
+
+            using var dlg =
+                new CountdownForm(
+                    act,
+                    30);
+
+            Theme.Apply(dlg);
+
+            if (dlg.ShowDialog(this) !=
+                DialogResult.OK)
+                return;
+
+            SaveState();
+
+            PowerActions.Run(act);
+        }
+
+        void ShowSettings(
+            string? section = null)
+        {
+            using var f =
+                new PreferencesForm(
+                    settings,
+                    section);
+
+            Theme.Apply(f);
+
+            if (f.ShowDialog(this) ==
+                DialogResult.OK)
+            {
+                ApplyPreferences();
+            }
+
+            SaveState();
+        }
+
+        // Preferences সেভ হলে যা যা সঙ্গে সঙ্গে প্রয়োগ হওয়া দরকার
+        void ApplyPreferences()
+        {
+            YtDlpCookies.Apply(settings);
+
+            Theme.SetMode(
+                settings.ThemeChoice);
+
+            ApplyTheme();
+            ApplyCompactView();
+
+            AppLog.Enabled =
+                settings.EnableLogging;
+
+            ApplyTrafficMode();
+            ApplyStartupAsync();
+
+            RebuildList();
+
+            if (settings.BridgeEnabled &&
+                bridge == null)
+            {
+                StartBridge();
+            }
+            else if (
+                !settings.BridgeEnabled &&
+                bridge != null)
+            {
+                StopBridge();
+            }
+        }
+
+        // Launch at startup: Windows-এর দিকে আসল পরিবর্তন (Store বিল্ডে StartupTask, portable-এ রেজিস্ট্রি)
+        async void ApplyStartupAsync()
+        {
+            try
+            {
+                bool want =
+                    settings.LaunchAtStartup;
+
+                var st =
+                    await StartupManager.SetAsync(
+                        want);
+
+                if (want &&
+                    st != StartupState.On)
+                {
+                    settings.LaunchAtStartup =
+                        false;
+
+                    SaveState();
+
+                    string why =
+                        st == StartupState.DisabledByUser
+                            ? "Windows has FastDM's startup turned off.\n\nOpen Task Manager → Startup apps, enable FastDM, then turn this option on again."
+                            : st == StartupState.DisabledByPolicy
+                                ? "Starting FastDM with Windows is blocked by your organization's policy."
+                                : "Launch at startup is not available in this build.";
+
+                    MessageBox.Show(
+                        this,
+                        why,
+                        "Launch at startup");
+                }
+            }
+            catch (Exception ex)
+            {
+                AppLog.Write(
+                    "Startup change failed: " +
+                    ex.Message);
+            }
+        }
+
+        // "Compact view of downloads list": ছোট সারি
+        void ApplyCompactView()
+        {
+            if (lv?.SmallImageList == null)
+                return;
+
+            lv.SmallImageList.ImageSize =
+                new Size(
+                    1,
+                    settings.CompactView
+                        ? 26
+                        : 34);
+
+            lv.Invalidate();
+        }
+
+        // ---------- ট্রাফিক মোড (Low / Medium / High) ----------
+        void BuildModeMenu()
+        {
+            bool icons =
+                Icons.Available;
+
+            modeMenu =
+                new ToolStripDropDownButton(
+                    icons
+                        ? "Mode"
+                        : "⚡  Mode")
+                {
+                    DisplayStyle = icons
+                        ? ToolStripItemDisplayStyle.ImageAndText
+                        : ToolStripItemDisplayStyle.Text,
+
+                    TextImageRelation =
+                        TextImageRelation.ImageBeforeText,
+
+                    Padding =
+                        new Padding(4),
+
+                    Tag = new IconTag
+                    {
+                        Glyph = "\uE945",
+                        Accent = false
+                    }
+                };
+
+            modeMenu.DropDownOpening +=
+                (s, e) => RebuildModeItems();
+
+            RebuildModeItems();
+            UpdateModeButton();
+        }
+
+        void RebuildModeItems()
+        {
+            modeMenu.DropDownItems.Clear();
+
+            foreach (TrafficMode m in
+                     Enum.GetValues(
+                         typeof(TrafficMode)))
+            {
+                var mode = m;
+
+                var mi =
+                    new ToolStripMenuItem(
+                        mode +
+                        "   (" +
+                        settings.ProfileOf(mode).Describe() +
+                        ")")
+                    {
+                        Checked =
+                            mode ==
+                            settings.ActiveMode
+                    };
+
+                mi.Click += (s, e) =>
+                    SetTrafficMode(mode);
+
+                modeMenu.DropDownItems.Add(mi);
+            }
+
+            modeMenu.DropDownItems.Add(
+                new ToolStripSeparator());
+
+            modeMenu.DropDownItems.Add(
+                "Edit modes…",
+                null,
+                (s, e) => ShowSettings(
+                    "Traffic Limits"));
+        }
+
+        void UpdateModeButton()
+        {
+            if (modeMenu != null)
+            {
+                modeMenu.Text =
+                    "Mode: " +
+                    settings.ActiveMode;
+
+                RequestToolbarFit();
+            }
+        }
+
+        void SetTrafficMode(
+            TrafficMode mode)
+        {
+            settings.ActiveMode =
+                mode;
+
+            ApplyTrafficMode();
+            SaveState();
+        }
+
+        // সক্রিয় মোডের মান ইঞ্জিনে বসানো: গতি, মোট ও প্রতি-সার্ভারের কানেকশন, একসাথে ডাউনলোড
+        void ApplyTrafficMode()
+        {
+            settings.TrafficMigrated = true;
+            settings.ApplyActiveProfile();
+
+            SpeedLimiter.SetKBps(
+                settings.SpeedLimitKBps);
+
+            var p =
+                settings.ActiveProfile;
+
+            Traffic.Configure(
+                p.MaxConnections,
+                p.PerServer);
+
+            UpdateModeButton();
+        }
+
+        // ---------- থিম প্রয়োগ ----------
+        void ApplyTheme()
+        {
+            var p = Theme.P;
+
+            SuspendLayout();
+
+            BackColor = p.Window;
+            ForeColor = p.Text;
+
+            lv.BackColor = p.Window;
+            lv.ForeColor = p.Text;
+
+            sidebar.BackColor = p.SideBg;
+
+            Theme.StyleStrip(tools);
+            Theme.StyleStrip(statusBar);
+            if (lv.ContextMenuStrip != null) Theme.StyleStrip(lv.ContextMenuStrip);
+            Theme.StyleStrip(trayMenu);
+            Theme.StyleStrip(modeMenu.DropDown);
+            Theme.StyleStrip(doneMenu.DropDown);
+
+            lblActive.ForeColor =
+                p.SubText;
+
+            lblSpeed.ForeColor =
+                p.SubText;
+
+            lblLimit.ForeColor =
+                p.SubText;
+
+            lblSched.ForeColor =
+                p.SubText;
+
+            details?.Invalidate();
+
+            RefreshToolIcons();
+
+            Theme.SetTitleBar(this);
+            Theme.StyleScroll(lv);
+            Theme.StyleScroll(sidebar);
+
+            ResumeLayout(true);
+
+            lv.Invalidate(true);
+
+            UpdateSideCounts();
+            sidebar.Invalidate();
+
+            Invalidate(true);
+        }
+
+        void OnSysPrefChanged(
+            object? sender,
+            UserPreferenceChangedEventArgs e)
+        {
+            if (
+                e.Category !=
+                    UserPreferenceCategory.General ||
+                settings.ThemeChoice !=
+                    ThemeMode.System)
+                return;
+
+            try
+            {
+                BeginInvoke(
+                    new Action(() =>
+                    {
+                        Theme.SetMode(
+                            ThemeMode.System);
+
+                        ApplyTheme();
+                    }));
+            }
+            catch { }
+        }
+
+        // নামের কলাম বাদে শেষ কলাম বাকি জায়গা ভরবে
+        void FitLastColumn()
+        {
+            if (lv == null ||
+                lv.Columns.Count == 0 ||
+                lv.ClientSize.Width <= 0)
+                return;
+
+            int used = 0;
+
+            for (int i = 0;
+                 i < lv.Columns.Count - 1;
+                 i++)
+            {
+                used +=
+                    lv.Columns[i].Width;
+            }
+
+            int w =
+                Math.Max(
+                    120,
+                    lv.ClientSize.Width - used);
+
+            var last =
+                lv.Columns[
+                    lv.Columns.Count - 1];
+
+            if (last.Width != w)
+                last.Width = w;
+        }
+    }
+}
diff --git a/FastDM/UI/MainForm.Shell.cs b/FastDM/UI/MainForm.Shell.cs
new file mode 100644
index 0000000..aaaff2b
--- /dev/null
+++ b/FastDM/UI/MainForm.Shell.cs
@@ -0,0 +1,483 @@
+using System;
+using System.Collections.Generic;
+using System.Diagnostics;
+using System.Drawing;
+using System.Drawing.Drawing2D;
+using System.IO;
+using System.Linq;
+using System.Net;
+using System.Net.Http;
+using System.Net.Http.Headers;
+using System.IO.Pipes;
+using System.Text;
+using System.Text.Json;
+using System.Text.Json.Serialization;
+using System.Threading;
+using System.Threading.Tasks;
+using System.Windows.Forms;
+using Microsoft.Win32;
+
+namespace FastDM
+{
+    // MainForm part: tray, sidebar, closing, notifications, drag-drop, clipboard.
+    public partial class MainForm
+    {
+        // ---------- সিস্টেম ট্রে ----------
+        void BuildTray()
+        {
+            trayMenu =
+                new ContextMenuStrip();
+
+            trayMenu.Items.Add(
+                "Open FastDM",
+                null,
+                (s, e) => RestoreFromTray());
+
+            trayMenu.Items.Add(
+                new ToolStripSeparator());
+
+            trayMenu.Items.Add(
+                "Pause all",
+                null,
+                (s, e) => PauseAll());
+
+            trayMenu.Items.Add(
+                "Resume all",
+                null,
+                (s, e) => ResumeAll());
+
+            trayMenu.Items.Add(
+                new ToolStripSeparator());
+
+            trayMenu.Items.Add(
+                "Exit",
+                null,
+                (s, e) => ExitApp());
+
+            Icon? ico = null;
+
+            try
+            {
+                ico =
+                    Icon.ExtractAssociatedIcon(
+                        Application.ExecutablePath);
+            }
+            catch { }
+
+            tray =
+                new NotifyIcon
+                {
+                    Icon =
+                        ico ?? SystemIcons.Application,
+
+                    Text = "FastDM",
+
+                    ContextMenuStrip =
+                        trayMenu,
+
+                    Visible = true
+                };
+
+            tray.DoubleClick +=
+                (s, e) => RestoreFromTray();
+
+            tray.BalloonTipClicked +=
+                (s, e) => RestoreFromTray();
+        }
+
+        void HideToTray(
+            bool showTip)
+        {
+            Hide();
+
+            if (showTip &&
+                !trayTipShown)
+            {
+                trayTipShown = true;
+
+                Notify(
+                    "FastDM",
+                    "Still running in the system tray. Click the icon to open it.");
+            }
+        }
+
+        void RestoreFromTray()
+        {
+            if (!Visible)
+                Show();
+
+            if (WindowState ==
+                FormWindowState.Minimized)
+            {
+                WindowState =
+                    FormWindowState.Normal;
+            }
+
+            Activate();
+        }
+
+        void ExitApp()
+        {
+            exiting = true;
+            Close();
+        }
+
+        void OnFormResize(
+            object? sender,
+            EventArgs e)
+        {
+            RequestToolbarFit();
+            FitLastColumn();
+
+            if (tray != null &&
+                settings.MinimizeToTray &&
+                WindowState ==
+                    FormWindowState.Minimized)
+            {
+                HideToTray(false);
+            }
+        }
+
+        void OnFormClosing(
+            object? sender,
+            FormClosingEventArgs e)
+        {
+            if (!exiting &&
+                e.CloseReason ==
+                    CloseReason.UserClosing)
+            {
+                if (settings.CloseToTray)
+                {
+                    e.Cancel = true;
+                    HideToTray(true);
+                    return;
+                }
+
+                bool busy =
+                    items.Any(i =>
+                        i.State ==
+                            DlState.Downloading ||
+                        i.State ==
+                            DlState.Queued);
+
+                if (busy)
+                {
+                    var r = MessageBox.Show(
+                        this,
+                        "Downloads are still running.\n\n" +
+                        "Yes = keep running in the system tray\n" +
+                        "No = exit (downloads will be paused)\n" +
+                        "Cancel = stay",
+                        "FastDM",
+                        MessageBoxButtons.YesNoCancel,
+                        MessageBoxIcon.Question);
+
+                    if (r ==
+                        DialogResult.Cancel)
+                    {
+                        e.Cancel = true;
+                        return;
+                    }
+
+                    if (r ==
+                        DialogResult.Yes)
+                    {
+                        e.Cancel = true;
+                        HideToTray(true);
+                        return;
+                    }
+                }
+            }
+
+            foreach (var it in items)
+                it.Cts?.Cancel();
+
+            SaveState();
+        }
+
+        void UpdateSideCounts()
+        {
+            for (int i = 0;
+                 i < sideCounts.Length;
+                 i++)
+            {
+                int idx = i;
+
+                sideCounts[i] =
+                    idx == DeletedFilter
+                        ? deleted.Count
+                        : items.Count(
+                            x => Match(idx, x));
+            }
+        }
+
+        // ---------- Sidebar ----------
+        void ToggleSidebar()
+        {
+            settings.SidebarOpen =
+                !settings.SidebarOpen;
+
+            UpdateSideCounts();
+
+            navTarget =
+                settings.SidebarOpen
+                    ? 200
+                    : 0;
+
+            if (settings.SidebarOpen)
+                sidebar.Visible = true;
+
+            navTimer.Start();
+
+            SaveState();
+        }
+
+        void StepSidebar()
+        {
+            const int step = 40;
+
+            int w =
+                sidebar.Width;
+
+            if (w < navTarget)
+            {
+                w =
+                    Math.Min(
+                        navTarget,
+                        w + step);
+            }
+            else if (w > navTarget)
+            {
+                w =
+                    Math.Max(
+                        navTarget,
+                        w - step);
+            }
+
+            sidebar.Width = w;
+
+            FitLastColumn();
+
+            if (w == navTarget)
+            {
+                navTimer.Stop();
+
+                if (w == 0)
+                    sidebar.Visible = false;
+                else
+                    sidebar.Invalidate();
+            }
+        }
+
+        void Cleanup()
+        {
+            try
+            {
+                SystemEvents.UserPreferenceChanged -=
+                    OnSysPrefChanged;
+            }
+            catch { }
+
+            try
+            {
+                timer?.Stop();
+                navTimer?.Stop();
+                toolbarFitTimer?.Stop();
+            }
+            catch { }
+
+            try
+            {
+                regWait?.Unregister(null);
+                showEvent?.Dispose();
+            }
+            catch { }
+
+            try
+            {
+                pipeCts?.Cancel();
+            }
+            catch { }
+
+            StopBridge();
+
+            if (tray != null)
+            {
+                tray.Visible = false;
+                tray.Dispose();
+                tray = null;
+            }
+
+            trayMenu?.Dispose();
+        }
+
+        // ---------- নোটিফিকেশন ----------
+        void Notify(
+            string title,
+            string text,
+            ToolTipIcon icon =
+                ToolTipIcon.Info)
+        {
+            if (tray == null ||
+                !settings.ShowNotifications)
+                return;
+
+            if (ActiveForm != null)
+                return;
+
+            try
+            {
+                if (title.Length > 60)
+                    title =
+                        title.Substring(
+                            0,
+                            60);
+
+                if (text.Length > 240)
+                    text =
+                        text.Substring(
+                            0,
+                            240) +
+                        "…";
+
+                tray.ShowBalloonTip(
+                    4000,
+                    title,
+                    text,
+                    icon);
+            }
+            catch { }
+        }
+
+        void NotifyError(
+            DownloadItem it)
+        {
+            if (!settings.NotifyFailed)
+                return;
+
+            if (
+                (DateTime.UtcNow -
+                 lastErrorNotify)
+                    .TotalSeconds < 10)
+                return;
+
+            lastErrorNotify =
+                DateTime.UtcNow;
+
+            Notify(
+                "Download failed",
+                it.FileName +
+                "\n" +
+                (it.Error ?? ""),
+                ToolTipIcon.Error);
+        }
+
+        // ---------- ড্র্যাগ-ড্রপ + ক্লিপবোর্ড ----------
+        // A single dropped .txt / .csv / .m3u / .m3u8 file is a list of links.
+        static string? DroppedListFile(DragEventArgs e)
+        {
+            if (e.Data?.GetData(DataFormats.FileDrop) is string[] files &&
+                files.Length == 1)
+            {
+                string ext = Path.GetExtension(files[0]).ToLowerInvariant();
+
+                if (ext == ".txt" || ext == ".csv" || ext == ".m3u" || ext == ".m3u8")
+                    return files[0];
+            }
+
+            return null;
+        }
+
+        void OnDragEnter(
+            object? s,
+            DragEventArgs e)
+        {
+            e.Effect =
+                e.Data != null &&
+                (e.Data.GetDataPresent(DataFormats.Text) ||
+                 DroppedListFile(e) != null)
+                    ? DragDropEffects.Copy
+                    : DragDropEffects.None;
+        }
+
+        void OnDragDrop(
+            object? s,
+            DragEventArgs e)
+        {
+            string? listFile = DroppedListFile(e);
+
+            if (listFile != null)
+            {
+                ImportListFile(listFile);
+                return;
+            }
+
+            if (e.Data?.GetData(
+                    DataFormats.Text)
+                is string t)
+            {
+                ShowAddDialog(
+                    t.Trim());
+            }
+        }
+
+        void CheckClipboard()
+        {
+            try
+            {
+                if (!Clipboard.ContainsText())
+                    return;
+
+                string t =
+                    Clipboard.GetText().Trim();
+
+                if (t == lastClip)
+                    return;
+
+                lastClip = t;
+
+                if (!Uri.TryCreate(
+                        t,
+                        UriKind.Absolute,
+                        out var u) ||
+                    (u.Scheme !=
+                        Uri.UriSchemeHttp &&
+                     u.Scheme !=
+                        Uri.UriSchemeHttps))
+                {
+                    return;
+                }
+
+                string ext =
+                    Path.GetExtension(
+                        u.AbsolutePath)
+                        .ToLowerInvariant();
+
+                if (!FileExts.Contains(ext))
+                    return;
+
+                BeginInvoke(
+                    new Action(
+                        () =>
+                            ShowAddDialog(t)));
+            }
+            catch { }
+        }
+
+        void ShowStartupNotice()
+        {
+            if (string.IsNullOrEmpty(startupNotice))
+                return;
+
+            string text = startupNotice;
+            startupNotice = null;
+
+            MessageBox.Show(
+                this,
+                text,
+                "FastDM",
+                MessageBoxButtons.OK,
+                MessageBoxIcon.Warning);
+        }
+    }
