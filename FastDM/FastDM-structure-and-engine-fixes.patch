-                            "File exists",
-                            MessageBoxButtons.YesNo,
-                            MessageBoxIcon.Question) ==
-                        DialogResult.Yes;
-                }
-            }
-
-            while (
-                (File.Exists(
-                    Path.Combine(
-                        folder,
-                        cand)) &&
-                 !(replaceExisting &&
-                   cand == name)) ||
-
-                File.Exists(
-                    Path.Combine(
-                        folder,
-                        cand) +
-                    ".part") ||
-
-                items.Any(i =>
-                    i.Folder == folder &&
-                    i.FileName.Equals(
-                        cand,
-                        StringComparison.OrdinalIgnoreCase)))
-            {
-                cand =
-                    stem +
-                    " (" +
-                    (n++) +
-                    ")" +
-                    ext;
-            }
-
-            return cand;
-        }
