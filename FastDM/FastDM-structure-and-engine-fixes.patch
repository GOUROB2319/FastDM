+        async Task AddYtDlpAsync(
+            string url,
+            string saveFolder,
+            bool startNow)
+        {
+            if (YtDlpLocator.Find() == null)
+            {
+                MessageBox.Show(
+                    this,
+                    "yt-dlp.exe was not found.\nPut yt-dlp.exe (and deno.exe) in the Tools folder next to the app.",
+                    "Video",
+                    MessageBoxButtons.OK,
+                    MessageBoxIcon.Warning);
+
+                return;
+            }
+
+            string path =
+                new Uri(url)
+                    .AbsolutePath
+                    .ToLowerInvariant();
+
+            if (path.StartsWith(
+                    "/playlist"))
+            {
+                MessageBox.Show(
+                    this,
+                    "Playlist links are not supported yet.\nOpen a single video link instead.",
+                    "Video",
+                    MessageBoxButtons.OK,
+                    MessageBoxIcon.Information);
+
+                return;
+            }
+
+            lblActive.Text =
+                "Reading video info…";
+
+            UseWaitCursor = true;
+
+            var readWatch = Stopwatch.StartNew();
+
+            using var readTick =
+                new System.Windows.Forms.Timer { Interval = 1000 };
+
+            readTick.Tick += (s, e) =>
+                lblActive.Text =
+                    "Reading video info\u2026 " +
+                    (int)readWatch.Elapsed.TotalSeconds +
+                    " s";
+
+            readTick.Start();
+
+            YtInfo info;
+
+            try
+            {
+                using var cts =
+                    new CancellationTokenSource(
+                        TimeSpan.FromSeconds(90));
+
+                info =
+                    await YtDlpInfo.LoadAsync(
+                        url,
+                        cts.Token);
+            }
+            catch (OperationCanceledException)
+            {
+                MessageBox.Show(
+                    this,
+                    "Reading the video info took too long.",
+                    "Video",
+                    MessageBoxButtons.OK,
+                    MessageBoxIcon.Warning);
+
+                return;
+            }
+            catch (Exception ex)
+            {
+                string hint =
+                    YtDlpCookies.HintFor(ex.GetBaseException().Message) ??
+                    (UpdateChecker.IsPackaged
+                        ? "\n\nIf this keeps happening, a newer app version (with an updated yt-dlp) may fix it."
+                        : "\n\nTry Settings → Update yt-dlp.");
+
+                MessageBox.Show(
+                    this,
+                    "Could not read this video.\n\n" +
+                    ex.GetBaseException().Message +
+                    hint,
+                    "Video",
+                    MessageBoxButtons.OK,
+                    MessageBoxIcon.Warning);
+
+                return;
+            }
+            finally
+            {
+                readTick.Stop();
+                UseWaitCursor = false;
+            }
+
+            using var pf =
+                new YtPickerForm(
+                    info,
+                    url,
+                    saveFolder);
+
+            Theme.Apply(pf);
+
+            if (pf.ShowDialog(this) !=
+                DialogResult.OK)
+                return;
+
+            string folder =
+                pf.SaveFolder;
+
+            var spec = pf.Spec;
+            if (spec == null) return;
+            string ext =
+                spec.AudioOnly
+                    ? "." + pf.Spec.AudioFormat
+                    : ".mp4";
+
+            var it = new DownloadItem
+            {
+                Url = url,
+                Folder = folder,
+                FileName =
+                    UniqueName(
+                        folder,
+                        pf.Spec.BaseName +
+                        ext),
+                YtDlp = pf.Spec,
+                State =
+                    startNow
+                        ? DlState.Queued
+                        : DlState.Paused
+            };
+
+            items.Add(it);
+            selectNewId = it.Id;
+
+            MarkChanged();
+            SaveState();
