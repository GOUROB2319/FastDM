-                    it.SlowSince = now;
-                    continue;
-                }
-
-                if (waiting > 0 &&
-                    it.Cts != null &&
-                    (now - it.SlowSince.Value)
-                        .TotalMinutes >=
-                    Math.Max(1, settings.PauseSlowMinutes))
