<Project Sdk="Microsoft.NET.Sdk">

	<!--
		Dependency-free test runner (no NuGet packages), so it runs anywhere the .NET SDK is installed.
		From the repository root run: dotnet run (the project folder FastDM.Tests, configuration Release).
		It exits with code 1 if any check fails.

		It compiles the REAL bridge source files below (linked, not copied), together with the small
		stand-ins in TestStubs.cs for the few WinForms-side types they touch. If someone renames a member
		that these files use, this project stops compiling, which is the signal to update the stub.
	-->
	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<RootNamespace>FastDM.Tests</RootNamespace>
		<IsPackable>false</IsPackable>
		<NoWarn>$(NoWarn);CA1416</NoWarn>
	</PropertyGroup>

	<ItemGroup>
		<Compile Include="..\FastDM\Bridge\BridgeAuth.cs" Link="Linked\BridgeAuth.cs" />
		<Compile Include="..\FastDM\Bridge\BridgeServer.cs" Link="Linked\BridgeServer.cs" />
		<Compile Include="..\FastDM\Bridge\BridgeModels.cs" Link="Linked\BridgeModels.cs" />
		<Compile Include="..\FastDM\Bridge\ProtocolHandler.cs" Link="Linked\ProtocolHandler.cs" />
		<Compile Include="..\FastDM\Core\StateStore.cs" Link="Linked\StateStore.cs" />
		<Compile Include="..\FastDM\YtDlp\YtDlpSites.cs" Link="Linked\YtDlpSites.cs" />
		<Compile Include="..\FastDM\Core\BatchImport.cs" Link="Linked\BatchImport.cs" />
		<Compile Include="..\FastDM\YtDlp\YtDlpOutput.cs" Link="Linked\YtDlpOutput.cs" />
		<Compile Include="..\FastDM\Core\FileCheck.cs" Link="Linked\FileCheck.cs" />
		<Compile Include="..\FastDM\Core\AppLog.cs" Link="Linked\AppLog.cs" />
		<Compile Include="..\FastDM\Core\DownloadCookieScope.cs" Link="Linked\DownloadCookieScope.cs" />
		<Compile Include="..\FastDM\Core\DownloadQueuePolicy.cs" Link="Linked\DownloadQueuePolicy.cs" />
		<Compile Include="..\FastDM\Core\HttpRangeValidation.cs" Link="Linked\HttpRangeValidation.cs" />
		<Compile Include="..\FastDM\Core\UrlCredential.cs" Link="Linked\UrlCredential.cs" />
		<Compile Include="..\FastDM\YtDlp\YtDlpDiagnostics.cs" Link="Linked\YtDlpDiagnostics.cs" />
		<Compile Include="..\FastDM\YtDlp\YtDlpMetadata.cs" Link="Linked\YtDlpMetadata.cs" />
		<Compile Include="..\FastDM\YtDlp\YtDlpRetryPolicy.cs" Link="Linked\YtDlpRetryPolicy.cs" />
		<Compile Include="..\FastDM\YtDlp\YtDlpProxy.cs" Link="Linked\YtDlpProxy.cs" />
		<Compile Include="..\FastDM\YtDlp\YtDlpUrlInput.cs" Link="Linked\YtDlpUrlInput.cs" />
		<Compile Include="..\FastDM\YtDlp\YtDlpProcessEnvironment.cs" Link="Linked\YtDlpProcessEnvironment.cs" />
		<Compile Include="..\FastDM\UI\DownloadDisplayName.cs" Link="Linked\DownloadDisplayName.cs" />
		<Compile Include="..\FastDM\UI\DownloadColumnLayout.cs" Link="Linked\DownloadColumnLayout.cs" />
		<Compile Include="..\FastDM\UI\DownloadRowRefreshPolicy.cs" Link="Linked\DownloadRowRefreshPolicy.cs" />
		<Compile Include="..\FastDM\UI\DropDownPlacementPolicy.cs" Link="Linked\DropDownPlacementPolicy.cs" />
