		<Compile Include="..\FastDM\YtDlp\YtThumbnailPolicy.cs" Link="Linked\YtThumbnailPolicy.cs" />
		<Compile Include="..\FastDM\UI\ToolbarLayoutPolicy.cs" Link="Linked\ToolbarLayoutPolicy.cs" />
